
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Academic Dashboard</title>

    <style>
      
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6fb;
            color: #263247;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        
        .dashboard {
            display: flex;
            min-height: 100vh;
        }

        
        .sidebar {
            width: 245px;
            background: #172554;
            color: white;
            padding: 25px 18px;
            flex-shrink: 0;
        }

        .logo {
            font-size: 23px;
            margin-bottom: 35px;
            text-align: center;
        }

        .logo span {
            color: #60a5fa;
        }

        .profile {
            text-align: center;
            padding: 20px 10px;
            background: #243768;
            border-radius: 15px;
            margin-bottom: 30px;
        }

        .profile-icon {
            width: 75px;
            height: 75px;
            background: #bfdbfe;
            color: #1e3a8a;
            border-radius: 50%;
            margin: 0 auto 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 35px;
        }

        .profile h3 {
            font-size: 17px;
            margin-bottom: 5px;
        }

        .profile p {
            color: #cbd5e1;
            font-size: 13px;
        }

        .menu-title {
            color: #93a8d0;
            font-size: 12px;
            margin: 20px 12px 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .sidebar nav a {
            display: block;
            padding: 13px 15px;
            margin: 7px 0;
            border-radius: 9px;
            transition: 0.3s;
        }

        .sidebar nav a:hover,
        .sidebar nav a.active {
            background: #3b82f6;
            color: white;
        }

        
        .main-content {
            flex: 1;
            min-width: 0;
            padding: 28px;
        }

      
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 30px;
        }

        .topbar h1 {
            font-size: 28px;
            margin-bottom: 7px;
        }

        .topbar p {
            color: #718096;
        }

        .date-badge {
            background: white;
            padding: 12px 18px;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
            font-size: 14px;
        }

        
        .welcome-banner {
            background: linear-gradient(120deg, #2563eb, #7c3aed);
            color: white;
            padding: 30px;
            border-radius: 18px;
            margin-bottom: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .welcome-banner h2 {
            font-size: 27px;
            margin-bottom: 10px;
        }

        .welcome-banner p {
            color: #e0e7ff;
            line-height: 1.7;
        }

        .welcome-icon {
            font-size: 75px;
        }

        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            padding: 22px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
            border-bottom: 4px solid #3b82f6;
            transition: 0.3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .stat-icon {
            font-size: 28px;
            margin-bottom: 12px;
        }

        .stat-card p {
            color: #718096;
            font-size: 14px;
        }

        .stat-card h2 {
            font-size: 29px;
            margin: 8px 0;
        }

        .stat-card small {
            color: #16a34a;
        }

        .purple {
            border-color: #8b5cf6;
        }

        .green {
            border-color: #22c55e;
        }

        .orange {
            border-color: #f97316;
        }

        
        .section {
            background: white;
            padding: 25px;
            border-radius: 15px;
            margin-bottom: 28px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
            scroll-margin-top: 20px;
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 22px;
        }

        .section-heading h2 {
            font-size: 20px;
        }

        .section-heading a {
            color: #2563eb;
            font-size: 14px;
        }

        /* TABLES */
        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 500px;
        }

        th,
        td {
            padding: 15px 12px;
            text-align: left;
            border-bottom: 1px solid #edf0f5;
            font-size: 14px;
        }

        th {
            color: #718096;
            background: #f8fafc;
            font-weight: 600;
        }

        td {
            color: #334155;
        }

        .grade {
            display: inline-block;
            background: #dcfce7;
            color: #15803d;
            padding: 5px 11px;
            border-radius: 20px;
            font-weight: bold;
        }

        .status {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            background: #dbeafe;
            color: #1d4ed8;
        }

        .status.upcoming {
            background: #fef3c7;
            color: #92400e;
        }

        
        .attendance-list {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 25px;
        }

        .attendance-item {
            padding: 15px;
            border: 1px solid #edf0f5;
            border-radius: 12px;
        }

        .attendance-top {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 12px;
        }

        .attendance-top h3 {
            font-size: 15px;
        }

        .attendance-top span {
            font-weight: bold;
            color: #2563eb;
        }

        .progress-track {
            height: 9px;
            background: #e5e7eb;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            border-radius: 10px;
            background: #3b82f6;
        }

        .progress-green {
            background: #22c55e;
        }

        .progress-orange {
            background: #f97316;
        }

        .progress-purple {
            background: #8b5cf6;
        }

        .attendance-item small {
            display: block;
            margin-top: 9px;
            color: #718096;
        }

        /* SUBJECT CARDS */
        .subject-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .subject-card {
            padding: 20px;
            border: 1px solid #edf0f5;
            border-radius: 12px;
            transition: 0.3s;
        }

        .subject-card:hover {
            border-color: #93c5fd;
            transform: translateY(-3px);
        }

        .subject-card .subject-icon {
            font-size: 30px;
            margin-bottom: 12px;
        }

        .subject-card h3 {
            font-size: 16px;
            margin-bottom: 7px;
        }

        .subject-card p {
            font-size: 13px;
            color: #718096;
            margin-bottom: 15px;
        }

        .subject-card strong {
            color: #2563eb;
        }

        
        .announcement {
            display: flex;
            gap: 15px;
            padding: 17px 0;
            border-bottom: 1px solid #edf0f5;
        }

        .announcement:last-child {
            border-bottom: none;
        }

        .announcement-icon {
            min-width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #dbeafe;
            font-size: 22px;
        }

        .announcement h3 {
            font-size: 15px;
            margin-bottom: 5px;
        }

        .announcement p {
            font-size: 13px;
            color: #718096;
            line-height: 1.6;
        }

        .announcement small {
            display: block;
            color: #94a3b8;
            margin-top: 7px;
        }

    
        footer {
            text-align: center;
            color: #718096;
            font-size: 13px;
            padding: 15px 0;
        }

      
        @media (max-width: 1100px) {
            .stats-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .subject-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

      
        @media (max-width: 700px) {
            .dashboard {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                padding: 18px;
            }

            .logo {
                margin-bottom: 18px;
            }

            .profile {
                margin-bottom: 18px;
            }

            .menu-title {
                display: none;
            }

            .sidebar nav {
                display: flex;
                flex-wrap: wrap;
                gap: 5px;
                justify-content: center;
            }

            .sidebar nav a {
                padding: 10px;
                font-size: 13px;
                margin: 0;
            }

            .main-content {
                padding: 18px;
            }

            .topbar {
                flex-direction: column;
                align-items: flex-start;
            }

            .topbar h1 {
                font-size: 24px;
            }

            .welcome-banner {
                padding: 23px;
            }

            .welcome-banner h2 {
                font-size: 22px;
            }

            .welcome-icon {
                font-size: 45px;
            }

            .attendance-list,
            .subject-grid {
                grid-template-columns: 1fr;
            }

            .section {
                padding: 18px;
            }
        }

        @media (max-width: 420px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }

            .welcome-icon {
                display: none;
            }

            .section-heading h2 {
                font-size: 18px;
            }
        }
    </style>
</head>

