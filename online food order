
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Foodie Hub | Online Food Ordering</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #fffaf5;
            color: #333;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
        }

        
        header {
            background: white;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar {
            max-width: 1200px;
            margin: auto;
            padding: 18px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .logo {
            color: #e94b25;
            font-size: 25px;
        }

        .nav-links {
            display: flex;
            gap: 25px;
            list-style: none;
        }

        .nav-links a {
            color: #333;
            font-weight: bold;
        }

        .nav-links a:hover {
            color: #e94b25;
        }

        .nav-button,
        .main-button {
            display: inline-block;
            background: #e94b25;
            color: white;
            padding: 12px 23px;
            border-radius: 25px;
            font-weight: bold;
            transition: 0.3s;
        }

        .nav-button:hover,
        .main-button:hover {
            background: #bd3517;
            transform: translateY(-2px);
        }

        
        .hero {
            min-height: 500px;
            display: flex;
            align-items: center;
            padding: 70px 8%;
            background:
                linear-gradient(90deg,
                rgba(0, 0, 0, 0.75),
                rgba(0, 0, 0, 0.25)),
                url("https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1600&q=85")
                center/cover no-repeat;
            color: white;
        }

        .hero-content {
            max-width: 620px;
            animation: slideIn 1s ease;
        }

        .tagline {
            color: #ffd166;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .hero h2 {
            font-size: clamp(32px, 5vw, 52px);
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .hero-content > p:not(.tagline) {
            font-size: 17px;
            margin-bottom: 28px;
        }

        
        .categories,
        .features {
            padding: 65px 6%;
            text-align: center;
        }

        .categories h2,
        .menu h2,
        .features h2,
        .contact h2 {
            font-size: 32px;
            margin-bottom: 30px;
        }

        .category-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 22px;
        }

        .category {
            width: 150px;
            padding: 25px 15px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.07);
            color: #333;
            transition: 0.3s;
        }

        .category:hover {
            transform: translateY(-7px);
            color: #e94b25;
        }

        .category span {
            font-size: 40px;
        }

        .category h3 {
            margin-top: 10px;
        }

        
        .menu {
            padding: 65px 6%;
            background: #fff1e8;
            text-align: center;
        }

        .section-description {
            margin-top: -18px;
            margin-bottom: 35px;
            color: #666;
        }

        .food-container {
            max-width: 1200px;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 28px;
            text-align: left;
        }

        .food-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
            transition: 0.3s;
        }

        .food-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.14);
        }

        .food-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            display: block;
        }

        .food-info {
            padding: 22px;
        }

        .food-category {
            display: inline-block;
            color: #e94b25;
            background: #fff0e9;
            border-radius: 15px;
            padding: 4px 12px;
            font-size: 12px;
            font-weight: bold;
        }

        .food-info h3 {
            font-size: 21px;
            margin: 12px 0 8px;
        }

        .food-info p {
            color: #666;
            font-size: 14px;
            min-height: 45px;
        }

        .food-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
        }

        .price {
            color: #e94b25;
            font-size: 23px;
            font-weight: bold;
        }

        .order-button {
            background: #e94b25;
            color: white;
            padding: 9px 20px;
            border-radius: 20px;
            transition: 0.3s;
        }

        .order-button:hover {
            background: #bd3517;
        }

        
        .offer {
            margin: 65px 6%;
            padding: 55px 25px;
            border-radius: 20px;
            background: linear-gradient(135deg, #ffb36b, #ff7043);
            color: white;
            text-align: center;
        }

        .offer p {
            margin-bottom: 12px;
        }

        .offer h2 {
            font-size: clamp(25px, 4vw, 36px);
            margin-bottom: 15px;
        }

        .offer .main-button {
            margin-top: 15px;
            background: white;
            color: #e94b25;
        }

  
        .feature-container {
            max-width: 1100px;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 25px;
        }

        .feature {
            background: white;
            padding: 30px 20px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        }

        .feature span {
            font-size: 40px;
        }

        .feature h3 {
            margin: 15px 0 8px;
        }

        .feature p {
            color: #666;
        }

        /* Contact */
        .contact {
            background: #fff1e8;
            padding: 65px 20px;
            text-align: center;
        }

        .contact-box {
            margin: 25px auto;
            line-height: 2;
        }

        .contact .main-button {
            margin-top: 10px;
        }

        /* Footer */
        footer {
            padding: 30px 20px;
            text-align: center;
            background: #292522;
            color: white;
        }

        footer h2 {
            color: #ff805c;
            margin-bottom: 8px;
        }

        footer p {
            font-size: 14px;
            margin-top: 5px;
        }

        /* Animation */
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Tablet */
        @media (max-width: 900px) {
            .food-container {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .navbar {
                flex-wrap: wrap;
                justify-content: center;
            }

            .nav-links {
                flex-wrap: wrap;
                justify-content: center;
            }
        }

        /* Mobile */
        @media (max-width: 600px) {
            .navbar {
                flex-direction: column;
                padding: 15px;
            }

            .nav-links {
                gap: 15px;
                font-size: 14px;
            }

            .hero {
                min-height: 420px;
                padding: 50px 7%;
            }

            .food-container,
            .feature-container {
                grid-template-columns: 1fr;
            }

            .categories h2,
            .menu h2,
            .features h2,
            .contact h2 {
                font-size: 27px;
            }

            .food-card img {
                height: 230px;
            }

            .offer {
                margin: 35px 5%;
                padding: 40px 20px;
            }
        }
    </style>
</head>

