                            <td>Alex Morgan</td>
                        </tr>

                        <tr>
                            <td>Tuesday</td>
                            <td>Yoga</td>
                            <td>8:00 AM</td>
                            <td>Sophia Williams</td>
                        </tr>

                        <tr>
                            <td>Wednesday</td>
                            <td>Cardio Fitness</td>
                            <td>6:00 PM</td>
                            <td>Jordan Lee</td>
                        </tr>

                        <tr>
                            <td>Thursday</td>
                            <td>Strength Training</td>
                            <td>7:00 AM</td>
                            <td>Alex Morgan</td>
                        </tr>

                        <tr>
                            <td>Friday</td>
                            <td>Yoga & Flexibility</td>
                            <td>6:00 PM</td>
                            <td>Sophia Williams</td>
                        </tr>

                        <tr>
                            <td>Saturday</td>
                            <td>Group Fitness</td>
                            <td>9:00 AM</td>
                            <td>Jordan Lee</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    
    <section class="section registration" id="register">
        <div class="container">
            <h2 class="section-title">
                Start Your <span class="highlight">Journey</span>
            </h2>

            <p class="section-subtitle">
                Fill in the form to express your interest in joining IRONFIT.
            </p>

            <form class="form-container" action="#" method="get">
                <div class="form-grid">

                    <div class="form-group">
                        <label for="name">Full Name</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter your name"
                            required>
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Enter your email"
                            required>
                    </div>

                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            placeholder="Enter your phone number"
                            required>
                    </div>

                    <div class="form-group">
                        <label for="plan">Membership Plan</label>
                        <select id="plan" name="plan" required>
                            <option value="">Select a plan</option>
                            <option value="basic">Basic - ₹999/month</option>
                            <option value="premium">Premium - ₹1,999/month</option>
                            <option value="elite">Elite - ₹2,999/month</option>
                        </select>
                    </div>

                    <div class="form-group full">
                        <label for="program">Preferred Workout Program</label>
                        <select id="program" name="program" required>
                            <option value="">Select a program</option>
                            <option value="strength">Strength Training</option>
                            <option value="yoga">Yoga & Flexibility</option>
                            <option value="cardio">Cardio Fitness</option>
                            <option value="group">Group Fitness</option>
